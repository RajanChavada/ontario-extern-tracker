{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "oet.publish-artifact/1"
    },
    "postId": {
      "type": "string",
      "pattern": "^oet-[a-z0-9-]+-(tiktok|instagram)$",
      "description": "Stable: same campaign + platform = same post. A publisher never posts the same postId twice."
    },
    "specId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "demo"
      ]
    },
    "platform": {
      "type": "string",
      "enum": [
        "tiktok",
        "instagram"
      ]
    },
    "aspectRatio": {
      "type": "string",
      "enum": [
        "9:16",
        "4:5"
      ]
    },
    "size": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "images": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "path": {
            "type": "string",
            "description": "Relative to this artifact file."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "alt": {
            "type": "string"
          },
          "layout": {
            "type": "string"
          }
        },
        "required": [
          "order",
          "path",
          "sha256",
          "alt",
          "layout"
        ],
        "additionalProperties": false
      }
    },
    "previews": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Interface-overlay previews for human review. Never publish these."
    },
    "contactSheet": {
      "type": "string"
    },
    "caption": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "full": {
          "type": "string",
          "description": "Exactly what to paste: text + blank line + hashtags."
        }
      },
      "required": [
        "text",
        "hashtags",
        "full"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "primary": {
            "type": "boolean"
          },
          "accessedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "capturedAt": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": [
              "file",
              "capturedAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "url",
          "publisher",
          "title",
          "primary",
          "accessedAt"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim": {
            "type": "string"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "value",
          "claim",
          "verifiedAt",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "checkedAgainst": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "oldestVerifiedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "newestVerifiedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "postBy": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last day this may be published (the day before the earliest deadline)."
        },
        "reverifyBy": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "checkedAgainst",
        "oldestVerifiedAt",
        "newestVerifiedAt",
        "postBy",
        "reverifyBy"
      ],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "factual": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "where": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": {}
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "where": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "passed",
            "errors",
            "warnings"
          ],
          "additionalProperties": false
        },
        "visual": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "where": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": {}
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "where": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "passed",
            "errors",
            "warnings"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "passed",
        "factual",
        "visual"
      ],
      "additionalProperties": false
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "invalidated"
          ]
        },
        "by": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedContentHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "by",
        "at",
        "approvedContentHash",
        "note"
      ],
      "additionalProperties": false
    },
    "publishable": {
      "type": "boolean",
      "description": "validation.passed AND approval.status = approved AND approval matches contentHash. The publisher must still check postBy and its own ledger."
    },
    "generatedAt": {
      "type": "string"
    },
    "generator": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string"
        },
        "spec": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "engine",
        "spec"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "postId",
    "specId",
    "title",
    "status",
    "platform",
    "aspectRatio",
    "size",
    "images",
    "previews",
    "contactSheet",
    "caption",
    "sources",
    "facts",
    "verification",
    "validation",
    "contentHash",
    "approval",
    "publishable",
    "generatedAt",
    "generator"
  ],
  "additionalProperties": false
}
